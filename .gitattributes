# Normalize line endings: LF in the repository, LF on checkout.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.dll binary
*.lib binary
*.so binary
*.dylib binary
*.exe binary
*.zip binary
*.bin binary
